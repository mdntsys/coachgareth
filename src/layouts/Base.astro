---
import '../styles/global.css';
import {
  NAP,
  HOURS,
  TESTS,
  PACKAGES,
  COACHING,
  STORE,
  FAQS,
  COACHING_FAQS,
} from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  /** Hero image to preload. Set on any page whose LCP is a photograph. */
  preload?: string;
  /**
   * Which token set to render against. Dark is the design; light exists so the
   * same page can be reviewed on a white ground. See the light-theme block in
   * global.css — nothing there applies unless this is 'light'.
   */
  theme?: 'dark' | 'light';
  /** When false, skip the page-level FAQPage node (inner pages). */
  includeFaq?: boolean;
  robots?: string;
}

const {
  title,
  description,
  path = '',
  image = '/images/imbackground.jpg',
  preload,
  theme = 'dark',
  includeFaq = true,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;

const site = 'https://www.coachgareth.com';
// Canonicals are written WITHOUT a trailing slash (except the root) to match
// `trailingSlash: 'never'` + `build.format: 'file'`. See astro.config.mjs.
const canonical = path ? `${site}/${path.replace(/^\/|\/$/g, '')}` : site;
// Share card is a dedicated 1200×630 — iMessage / iOS / Slack crop page
// photographs into an unreadable square. Schema still gets the page photo.
const ogImage = new URL('/images/og.jpg', site).href;
const schemaImage = new URL(image, site).href;
const ogAlt =
  'Coach Gareth — ECLYPSE Fitness Lab. VO2 max and lactate testing in Santa Monica.';

const openingHours = HOURS.filter((h) => h.open).map((h) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: `https://schema.org/${h.day}`,
  opens: h.open,
  closes: h.close,
}));

/*
  The audit found NO structured data on either domain beyond a bare `WebSite`
  node (findings §4). Meanwhile the DR-8 Glendale competitor earns 40 AI
  citations to this business's 0 (§0.6). Schema is the cheapest part of closing
  that gap, because it hands the models the facts in a form they can quote.

  Deliberately ABSENT: `aggregateRating`. He has 75 genuine five-star reviews,
  but they live on Google, not on this site. Marking up review data the site
  does not itself host is self-serving review markup under Google's guidelines
  and is a manual-action risk. The audit's single best finding is that he has
  no manual actions — introducing one for a star snippet would be a bad trade.
  The reviews stay on the page as plain testimonials, which is safe.
*/
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsActivityLocation'],
  '@id': `${site}/#business`,
  name: NAP.legalName,
  alternateName: ['ECLYPSE Lab', 'ECLYPSE Fitness Lab', 'Coach Gareth'],
  description,
  url: site,
  telephone: NAP.phone,
  email: NAP.email,
  image: schemaImage,
  priceRange: `$${TESTS[2].price}–$1250`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: NAP.street,
    addressLocality: NAP.city,
    addressRegion: NAP.region,
    postalCode: NAP.postal,
    addressCountry: NAP.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.0106, longitude: -118.4703 },
  openingHoursSpecification: openingHours,
  areaServed: [
    'Santa Monica',
    'Los Angeles',
    'Venice',
    'Culver City',
    'Marina del Rey',
    'Pacific Palisades',
    'Brentwood',
    'El Segundo',
  ].map((n) => ({ '@type': 'City', name: n })),
  founder: {
    '@type': 'Person',
    '@id': `${site}/#gareth`,
    name: NAP.personName,
    jobTitle: 'Endurance Coach & Exercise Physiologist',
    description:
      'Endurance coach with 30+ years working with elite athletes. Former head coach of UCLA Triathlon and a Team Great Britain competitor.',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Metabolic and performance testing',
    itemListElement: [
      ...TESTS.map((t) => ({
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: t.price,
        itemOffered: {
          '@type': 'Service',
          name: t.name,
          description: t.tagline,
          serviceType: t.name,
          areaServed: { '@type': 'City', name: 'Los Angeles' },
          provider: { '@id': `${site}/#business` },
        },
      })),
      // Sport-specific testing packages and the monthly coaching tiers. Both
      // exist on his current sites only as flat images, so nothing in them is
      // machine-readable today — no engine can read the prices and no AI model
      // can quote what is included. Emitting them as real offers is the
      // cheapest GEO gain available on this page.
      ...PACKAGES.flatMap((p) =>
        p.tiers.map((t) => ({
          '@type': 'Offer',
          priceCurrency: 'USD',
          price: t.price,
          itemOffered: {
            '@type': 'Service',
            name: `${p.sport} — ${t.name} testing package`,
            description: t.tests.join(', '),
            provider: { '@id': `${site}/#business` },
          },
        }))
      ),
      ...COACHING.tiers.map((t) => ({
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: t.price,
        // Coaching is billed monthly; without this an agent reads $300 as a
        // one-off fee and materially understates the cost.
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: t.price,
          priceCurrency: 'USD',
          unitCode: 'MON',
          billingDuration: 1,
        },
        itemOffered: {
          '@type': 'Service',
          name: `${t.name} coaching`,
          description: t.includes.join(', '),
          serviceType: 'Endurance coaching',
          provider: { '@id': `${site}/#business` },
        },
      })),
      ...STORE.groups.flatMap((g) =>
        g.items.map((item) => ({
          '@type': 'Offer',
          priceCurrency: 'USD',
          price: item.price,
          url: item.href.startsWith('http')
            ? item.href
            : `${site}/coaching`,
          itemOffered: {
            '@type': 'Service',
            name: item.name,
            description: item.detail,
            serviceType: g.name,
            provider: { '@id': `${site}/#business` },
          },
        }))
      ),
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // Testing AND coaching questions in one FAQPage — Google expects a single
  // node per page, not one per on-page group.
  mainEntity: [...FAQS, ...COACHING_FAQS].map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="theme-color"
      content={theme === 'light' ? '#ffffff' : '#0b0c0e'}
    />
    <meta name="robots" content={robots} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coach Gareth · ECLYPSE Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {/* The hero photograph is the LCP element. Preloading it at high priority
        starts the fetch alongside the CSS instead of after layout, which is
        the difference between the headline landing on an image and landing on
        an empty box. */}
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessSchema)}
    />
    {includeFaq && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-signal focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
