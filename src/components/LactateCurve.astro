---
/*
  Lactate curve — Gareth's model (2026-08-19).

  Recreated as inline SVG to match site type and tokens, but the geometry is
  his: five zones, AeT / LT1 at the top of Z2 (2 mmol), and Z4 as a narrow
  band sitting just below and just above 4 mmol (SST / LT2). Colours are the
  same ramp as the YOUR TRAINING ZONES strip so the two graphics read as one
  system. The shape is a typical staged response, not any athlete's data.
*/

const X0 = 64;
const X1 = 772;
const Y0 = 36;
const Y1 = 328;
const PLOT_W = X1 - X0;
const PLOT_H = Y1 - Y0;

const x = (i: number) => X0 + i * PLOT_W;
const y = (mmol: number) => Y1 - (mmol / 8) * PLOT_H;

// Intensity shares taken off his graph so the curve and the zone strip agree.
const Z1 = 0.14;
const Z2 = 0.46; // AeT / LT1 — top of Z2 is 2 mmol
const Z3 = 0.68; // SST / LT2 — left edge of the 4 mmol band
const Z4 = 0.77;

const bands = [
  { from: 0, to: Z1, color: 'var(--color-zone-1)', label: 'Z1' },
  { from: Z1, to: Z2, color: 'var(--color-zone-2)', label: 'Z2' },
  { from: Z2, to: Z3, color: 'var(--color-zone-3)', label: 'Z3' },
  { from: Z3, to: Z4, color: 'var(--color-zone-4)', label: 'Z4' },
  { from: Z4, to: 1, color: 'var(--color-zone-5)', label: 'Z5' },
];

// Curve through his markers, then a last point above the frame so the
// arrow can leave the plot the way his drawing does.
const curvePts = [
  { i: 0.0, mmol: 1.3 },
  { i: Z1, mmol: 1.38 },
  { i: 0.3, mmol: 1.55 },
  { i: Z2, mmol: 2.0 },
  { i: 0.57, mmol: 2.55 },
  { i: Z3, mmol: 3.5 },
  { i: Z4, mmol: 4.8 },
  { i: 0.88, mmol: 6.85 },
  { i: 1.02, mmol: 9.3 },
];

const stagePts = curvePts.slice(1, 8);

const toXY = (p: { i: number; mmol: number }) => ({ x: x(p.i), y: y(p.mmol) });

function catmullToPath(pts: { x: number; y: number }[]) {
  let d = `M ${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
  }
  return d;
}

const curve = catmullToPath(curvePts.map(toXY));

const markers = [
  { at: Z2, abbr: 'AeT / LT1', color: 'var(--color-zone-2)' },
  { at: Z3, abbr: 'SST / LT2', color: 'var(--color-zone-4)' },
];
---

<figure class="border border-line bg-surface p-4 sm:p-6">
  <svg
    viewBox="0 0 800 392"
    class="w-full"
    role="img"
    aria-label="A blood lactate curve with five training zones. The aerobic threshold sits at the top of zone 2 at 2 millimoles. Zone 4 is a narrow band just below and just above 4 millimoles, marked as the steady-state threshold."
  >
    <defs>
      <clipPath id="plot">
        <rect x={X0} y={Y0} width={PLOT_W} height={PLOT_H}></rect>
      </clipPath>
      <marker
        id="curve-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 1 L 9 5 L 0 9 z" fill="var(--color-ink)"></path>
      </marker>
    </defs>

    {
      bands.map((b) => (
        <rect
          x={x(b.from)}
          y={Y0}
          width={x(b.to) - x(b.from)}
          height={PLOT_H}
          fill={b.color}
          opacity="0.32"
        />
      ))
    }

    {
      [2, 4, 6, 8].map((m) => (
        <>
          <line
            x1={X0}
            x2={X1}
            y1={y(m)}
            y2={y(m)}
            stroke="var(--color-line)"
            stroke-width="1"
          />
          <text
            x={X0 - 12}
            y={y(m) + 4}
            text-anchor="end"
            class="fill-[var(--color-ink-dim)] font-mono text-[11px]"
          >
            {m}
          </text>
        </>
      ))
    }

    {
      [Z1, Z2, Z3, Z4].map((at) => (
        <line
          x1={x(at)}
          x2={x(at)}
          y1={Y0}
          y2={Y1}
          stroke="var(--color-line-bright)"
          stroke-width="1"
        />
      ))
    }

    <line x1={X0} x2={X1} y1={Y1} y2={Y1} stroke="var(--color-line-bright)" />
    <line x1={X0} x2={X0} y1={Y0} y2={Y1} stroke="var(--color-line-bright)" />
    <line x1={X1} x2={X1} y1={Y0} y2={Y1} stroke="var(--color-line)" />
    <line x1={X0} x2={X1} y1={Y0} y2={Y0} stroke="var(--color-line)" />

    {
      markers.map((t) => (
        <>
          <line
            x1={x(t.at)}
            x2={x(t.at)}
            y1={Y0}
            y2={Y1}
            stroke={t.color}
            stroke-width="1.75"
          />
          <text
            x={x(t.at)}
            y={Y0 - 12}
            text-anchor="middle"
            fill={t.color}
            class="font-mono text-[11px] font-bold tracking-wider"
          >
            {t.abbr}
          </text>
        </>
      ))
    }

    <path
      d={curve}
      fill="none"
      stroke="var(--color-ink)"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      clip-path="url(#plot)"
    />
    {/* Arrow leaves the frame at the top of Z5, as on Gareth's drawing. */}
    <line
      x1={x(0.93)}
      y1={y(7.55)}
      x2={X1 + 10}
      y2={Y0 - 8}
      stroke="var(--color-ink)"
      stroke-width="2.5"
      stroke-linecap="round"
      marker-end="url(#curve-arrow)"
    />

    {
      stagePts.map((p) => (
        <circle
          cx={x(p.i)}
          cy={y(p.mmol)}
          r="4.5"
          fill="var(--color-ink)"
          stroke="var(--color-base)"
          stroke-width="1.5"
        />
      ))
    }

    {
      bands.map((b) => (
        <text
          x={(x(b.from) + x(b.to)) / 2}
          y={Y1 + 22}
          text-anchor="middle"
          fill={b.color}
          class="font-mono text-[11px] font-bold tracking-wider"
        >
          {b.label}
        </text>
      ))
    }

    <text
      x={X0 - 12}
      y={Y0 - 12}
      text-anchor="end"
      class="fill-[var(--color-ink-dim)] font-mono text-[11px]">mmol</text
    >
    <text
      x={X1}
      y={Y1 + 46}
      text-anchor="end"
      class="fill-[var(--color-ink-dim)] font-mono text-[11px]"
      >intensity →</text
    >
  </svg>
  <figcaption class="mt-3 text-xs leading-relaxed text-ink-dim">
    A typical lactate curve. Each point is one stage of the test. The top of
    Z2 is 2 mmol (AeT / LT1). Z4 is the narrow band just below and just above
    4 mmol (SST / LT2). Those two marks are where your training zones actually
    begin and end — not where a formula based on your age guesses they do.
  </figcaption>
</figure>
