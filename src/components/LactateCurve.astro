---
/*
  Hand-drawn lactate curve.

  Built as inline SVG rather than using one of the chart screenshots harvested
  from the live sites, because those are ~600px JPEGs with baked-in Squarespace
  styling that go soft the moment they scale up. This renders crisply at any
  size, weighs nothing, inherits the theme colours, and is the one element on
  the page that says "lab" faster than any photograph could.

  The shape is a textbook lactate response — flat through the aerobic range,
  an inflection at the aerobic threshold, then the exponential climb past the
  steady-state threshold. It is illustrative of the curve every athlete gets
  back, NOT any individual client's data.
*/
const pts = [
  { kmh: 8, mmol: 0.9 },
  { kmh: 10, mmol: 1.0 },
  { kmh: 12, mmol: 1.2 },
  { kmh: 14, mmol: 1.6 },
  { kmh: 16, mmol: 2.4 },
  { kmh: 18, mmol: 4.0 },
  { kmh: 20, mmol: 7.2 },
];

const X0 = 70,
  X1 = 770,
  Y0 = 30,
  Y1 = 330;
const x = (k: number) => X0 + ((k - 8) / 12) * (X1 - X0);
const y = (m: number) => Y1 - (m / 8) * (Y1 - Y0);

const LT1 = x(16.4);
const LT2 = x(18);

const bands = [
  { from: X0, to: x(12), color: 'var(--color-zone-1)', label: 'Z1' },
  { from: x(12), to: LT1, color: 'var(--color-zone-2)', label: 'Z2' },
  { from: LT1, to: LT2, color: 'var(--color-zone-3)', label: 'Z3' },
  { from: LT2, to: X1, color: 'var(--color-zone-4)', label: 'Z4' },
];

const curve = `M ${x(8)},${y(0.9)}
  C ${x(9)},${y(0.97)} ${x(9.4)},${y(0.99)} ${x(10)},${y(1.0)}
  C ${x(10.9)},${y(1.05)} ${x(11.3)},${y(1.13)} ${x(12)},${y(1.2)}
  C ${x(12.8)},${y(1.3)} ${x(13.5)},${y(1.45)} ${x(14)},${y(1.6)}
  C ${x(14.7)},${y(1.83)} ${x(15.5)},${y(2.1)} ${x(16)},${y(2.4)}
  C ${x(16.7)},${y(2.85)} ${x(17.4)},${y(3.4)} ${x(18)},${y(4.0)}
  C ${x(18.6)},${y(4.7)} ${x(19.4)},${y(6.0)} ${x(20)},${y(7.2)}`;
---

<figure class="border border-line bg-surface p-4 sm:p-6">
  <svg
    viewBox="0 0 800 380"
    class="w-full"
    role="img"
    aria-label="A blood lactate curve showing lactate concentration rising with running speed, with the aerobic threshold and steady-state threshold marked and the four training zones shaded."
  >
    {/* zone bands */}
    {
      bands.map((b) => (
        <rect
          x={b.from}
          y={Y0}
          width={b.to - b.from}
          height={Y1 - Y0}
          fill={b.color}
          opacity="0.09"
        />
      ))
    }

    {/* horizontal gridlines at each mmol */}
    {
      [2, 4, 6, 8].map((m) => (
        <>
          <line
            x1={X0}
            x2={X1}
            y1={y(m)}
            y2={y(m)}
            stroke="var(--color-line)"
            stroke-width="1"
          />
          <text
            x={X0 - 12}
            y={y(m) + 4}
            text-anchor="end"
            class="fill-[var(--color-ink-dim)] font-mono text-[11px]"
          >
            {m}
          </text>
        </>
      ))
    }

    {/* axes */}
    <line x1={X0} x2={X1} y1={Y1} y2={Y1} stroke="var(--color-line-bright)" />
    <line x1={X0} x2={X0} y1={Y0} y2={Y1} stroke="var(--color-line-bright)" />

    {/* threshold markers */}
    {
      [
        { at: LT1, abbr: 'AeT / LT1', color: 'var(--color-zone-2)' },
        { at: LT2, abbr: 'SST / LT2', color: 'var(--color-zone-3)' },
      ].map((t) => (
        <>
          <line
            x1={t.at}
            x2={t.at}
            y1={Y0}
            y2={Y1}
            stroke={t.color}
            stroke-width="1.5"
            stroke-dasharray="4 4"
          />
          <text
            x={t.at}
            y={Y0 - 10}
            text-anchor="middle"
            fill={t.color}
            class="font-mono text-[11px] font-bold tracking-wider"
          >
            {t.abbr}
          </text>
        </>
      ))
    }

    {/* the curve */}
    <path
      d={curve}
      fill="none"
      stroke="var(--color-ink)"
      stroke-width="2.5"
      stroke-linecap="round"
    />

    {/* sample points — one per test stage */}
    {
      pts.map((p) => (
        <circle
          cx={x(p.kmh)}
          cy={y(p.mmol)}
          r="4.5"
          fill="var(--color-base)"
          stroke="var(--color-ink)"
          stroke-width="2"
        />
      ))
    }

    {/* zone labels along the foot */}
    {
      bands.map((b) => (
        <text
          x={(b.from + b.to) / 2}
          y={Y1 + 22}
          text-anchor="middle"
          fill={b.color}
          class="font-mono text-[11px] font-bold tracking-wider"
        >
          {b.label}
        </text>
      ))
    }

    {/* Axis unit sits ABOVE the axis, not beside it. At Y0+4 it landed on
        exactly the same baseline as the topmost (8 mmol) gridline label and
        the two overprinted each other. */}
    <text
      x={X0 - 12}
      y={Y0 - 12}
      text-anchor="end"
      class="fill-[var(--color-ink-dim)] font-mono text-[11px]">mmol/L</text
    >
    <text
      x={X1}
      y={Y1 + 46}
      text-anchor="end"
      class="fill-[var(--color-ink-dim)] font-mono text-[11px]"
      >Intensity →</text
    >
  </svg>
  <figcaption class="mt-3 text-xs leading-relaxed text-ink-dim">
    An illustrative lactate curve. Each point is one stage of the test. Where
    the line bends is where your training zones actually begin and end — not
    where a formula based on your age guesses they do.
  </figcaption>
</figure>
