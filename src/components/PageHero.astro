---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<section class="border-b border-line">
  {
    image ? (
      <div class="relative isolate overflow-hidden">
        <img
          src={image}
          alt={imageAlt}
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center opacity-80 grayscale"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-base via-base/70 to-base/30" />
        <div class="mx-auto max-w-7xl px-5 pb-14 pt-20 sm:px-8 lg:pb-20 lg:pt-28">
          <div class="max-w-3xl">
            <div class="eyebrow flex items-center gap-3">
              <span class="h-px w-8 bg-signal" />
              {eyebrow}
            </div>
            <h1 class="display mt-6 text-[clamp(1.7rem,8vw,4rem)]">{title}</h1>
            <p class="mt-7 max-w-2xl text-xl leading-snug text-ink sm:text-2xl">
              {lede}
            </p>
            <slot name="after" />
          </div>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-24">
        <div class="max-w-3xl">
          <div class="eyebrow flex items-center gap-3">
            <span class="h-px w-8 bg-signal" />
            {eyebrow}
          </div>
          <h1 class="display mt-6 text-[clamp(1.7rem,8vw,4rem)]">{title}</h1>
          <p class="mt-7 max-w-2xl text-xl leading-snug text-ink-muted">
            {lede}
          </p>
          <slot name="after" />
        </div>
      </div>
    )
  }
</section>
