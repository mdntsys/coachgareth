---
import { NAP, NAV } from '../data/site';
// Lab name comes from NAP so the header, footer and schema cannot drift apart
// — his sketch calls it "ECLYPSE Fitness Lab", not "ECLYPSE Lab".
---

<header
  class="sticky top-0 z-40 border-b border-line bg-base/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-5 sm:px-8">
    <a href="/" class="flex shrink-0 items-baseline gap-2.5">
      <span class="display text-lg tracking-tight">Coach Gareth</span>
      <span class="hidden h-3.5 w-px bg-line-bright sm:block"></span>
      <span class="eyebrow hidden sm:block">{NAP.labName}</span>
    </a>

    <nav class="ml-auto hidden items-center gap-7 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm text-ink-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-3 lg:ml-0">
      <a
        href={NAP.phoneHref}
        class="tnum hidden font-mono text-sm text-ink-muted transition-colors hover:text-ink md:block"
        >{NAP.phone}</a
      >
      <a
        href="#book"
        class="bg-signal px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-signal-dim"
        >Book a test</a
      >
      <button
        type="button"
        id="navToggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileNav"
        class="grid h-10 w-10 place-items-center border border-line text-ink lg:hidden"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true">
          <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.5"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobileNav" hidden class="border-t border-line bg-surface lg:hidden">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class="block border-b border-line px-5 py-4 text-sm text-ink-muted"
        >
          {item.label}
        </a>
      ))
    }
    <a href={NAP.phoneHref} class="tnum block px-5 py-4 font-mono text-sm">
      {NAP.phone}
    </a>
  </nav>
</header>

<script>
  // The only JavaScript on the page. Everything else is static HTML.
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mobileNav');
  toggle?.addEventListener('click', () => {
    const open = nav?.hasAttribute('hidden');
    if (open) nav?.removeAttribute('hidden');
    else nav?.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  // Anchor links must close the panel, or tapping one scrolls the page behind
  // a menu that is still covering it.
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.setAttribute('hidden', '');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
