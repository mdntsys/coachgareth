---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { POSTS } from '../../data/site';
import { POST_BODIES } from '../../data/posts';

export function getStaticPaths() {
  return POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: (typeof POSTS)[number];
}

const { post } = Astro.props;
const body = POST_BODIES[post.slug];
const others = POSTS.filter((p) => p.slug !== post.slug);

const linkClass =
  'text-ink underline decoration-line-bright underline-offset-4 transition-colors hover:text-signal hover:decoration-signal';

function renderInline(text: string) {
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    `<a href="$2" class="${linkClass}">$1</a>`,
  );
}
---

<Base
  title={`${post.title} | Coach Gareth · ECLYPSE`}
  description={post.description}
  path={`blog/${post.slug}`}
  image={body.image}
  preload={body.image}
  includeFaq={false}
>
  <Header />
  <main id="main">
    <PageHero
      eyebrow={body.eyebrow}
      title={post.title}
      lede={body.lede}
      image={body.image}
      imageAlt={body.imageAlt}
    />

    <article class="border-b border-line">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-24">
        <div class="max-w-3xl">
          {
            body.sections.map((section) => (
              <section class="mt-14 first:mt-0">
                <h2 class="display text-[clamp(1.35rem,2.4vw,1.85rem)]">
                  {section.heading}
                </h2>
                {section.paragraphs.map((p) => (
                  <p
                    class="mt-5 leading-relaxed text-ink-muted [&_a]:text-ink [&_a]:underline [&_a]:decoration-line-bright [&_a]:underline-offset-4 [&_a]:transition-colors hover:[&_a]:text-signal hover:[&_a]:decoration-signal"
                    set:html={renderInline(p)}
                  />
                ))}
                {section.list && (
                  <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
                    {section.list.map((item) => (
                      <li class="flex gap-3 leading-relaxed text-ink-muted">
                        <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-signal" />
                        <span set:html={renderInline(item)} />
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </article>

    <section class="border-b border-line bg-surface">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-20">
        <h2 class="display text-[clamp(1.5rem,2.6vw,2rem)]">
          More from the lab
        </h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {
            others.map((item) => {
              const other = POST_BODIES[item.slug];
              return (
                <article class="group flex flex-col border border-line bg-base transition-colors hover:border-line-bright">
                  <div class="relative aspect-[16/10] overflow-hidden">
                    <img
                      src={other.image}
                      alt={other.imageAlt}
                      class="h-full w-full object-cover opacity-70 grayscale transition-all duration-500 group-hover:opacity-90"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <div class="eyebrow">{other.eyebrow}</div>
                    <h3 class="display mt-3 text-xl">
                      <a
                        href={`/blog/${item.slug}`}
                        class="hover:text-signal"
                      >
                        {item.title}
                      </a>
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                      {item.description}
                    </p>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Base>
